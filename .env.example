# توکن ربات ایتایار (بدون پیشوند bot)
EITAA_TOKEN=

# آیدی/یوزرنیم کانال مقصد در ایتا (مثلاً @my_channel)
EITAA_CHANNEL=

# کانال‌های منبع تلگرام، جدا شده با ویرگول (مثلاً @channel1,@channel2)
SOURCE_CHANNELS=

# فاصله بین بررسی هر منبع (ثانیه)
FETCH_INTERVAL_SECONDS=3600

# فاصله بین ارسال پیام‌ها به ایتا (ثانیه) — برای جلوگیری از rate-limit
INTER_MESSAGE_DELAY_SECONDS=15
